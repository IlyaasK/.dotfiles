set shellopts '-eu'
set ifs "\n"
set scrolloff 10
set icons
set period 1
set hiddenfiles ".*:*.aux:*.bbl:*.bcf:*.blg:*.log:*.run.xml"

cmd open ${{
    opener="${OPENER:-xdg-open}"
    command -v "$opener" >/dev/null 2>&1 || opener="open"

    case "$(file --mime-type "$(readlink -f "$f")" -b)" in
        text/*|application/json|inode/x-empty|application/x-subrip) ${EDITOR:-nvim} $fx ;;
        image/*) setsid -f "$opener" $fx >/dev/null 2>&1 ;;
        audio/*|video/*) setsid -f mpv $fx >/dev/null 2>&1 ;;
        application/pdf|application/postscript|application/epub*) setsid -f zathura $fx >/dev/null 2>&1 ;;
        *) for path in $fx; do setsid -f "$opener" "$path" >/dev/null 2>&1; done ;;
    esac
}}

cmd mkdir $mkdir -p "$@"

cmd extract ${{
    clear
    set -f
    printf "%s\n\nextract? [y/N] " "$fx"
    read -r ans
    [ "$ans" = "y" ] || exit 0

    case "$fx" in
        *.tar.bz2|*.tbz2) tar xjf "$fx" ;;
        *.tar.gz|*.tgz) tar xzf "$fx" ;;
        *.tar.xz) tar xf "$fx" ;;
        *.tar) tar xf "$fx" ;;
        *.bz2) bunzip2 "$fx" ;;
        *.gz) gunzip "$fx" ;;
        *.zip) unzip "$fx" ;;
        *.rar) unrar e "$fx" ;;
        *.7z) 7z x "$fx" ;;
    esac
}}

cmd moveto ${{
    set -f
    dest="$(sed -e 's/\s*#.*//' -e '/^$/d' -e 's/^\S*\s*//' "${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs" | fzf --layout=reverse --height 40% --prompt 'Move to where? ')"
    [ -n "$dest" ] || exit 0
    destpath="$(eval printf '%s' "$dest")"
    printf "move to %s? [y/N] " "$destpath"
    read -r ans
    [ "$ans" = "y" ] || exit 0
    mv -iv -- $fx "$destpath"
}}

cmd copyto ${{
    set -f
    dest="$(sed -e 's/\s*#.*//' -e '/^$/d' -e 's/^\S*\s*//' "${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs" | fzf --layout=reverse --height 40% --prompt 'Copy to where? ')"
    [ -n "$dest" ] || exit 0
    destpath="$(eval printf '%s' "$dest")"
    printf "copy to %s? [y/N] " "$destpath"
    read -r ans
    [ "$ans" = "y" ] || exit 0
    cp -ivr -- $fx "$destpath"
}}

cmd bulkrename ${{
    old="$(mktemp)"
    new="$(mktemp)"
    [ -n "$fs" ] && basename -a $fs > "$old" || ls > "$old"
    cp "$old" "$new"
    ${EDITOR:-nvim} "$new"
    [ "$(wc -l < "$old")" -eq "$(wc -l < "$new")" ] || exit 1
    paste "$old" "$new" | while IFS="$(printf '\t')" read -r src dst; do
        [ "$src" = "$dst" ] || [ -e "$dst" ] || mv -- "$src" "$dst"
    done
    rm -f "$old" "$new"
    lf -remote "send $id unselect"
}}

map J $lf -remote "send $id cd \"$(sed -e 's/\s*#.*//' -e '/^$/d' -e 's/^\S*\s*//' ${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs | fzf)\""
map H cd ~
map g top
map C copyto
map M moveto
map E extract
map B bulkrename
map D delete
map <c-n> push :mkdir<space>""<left>
map <c-r> reload
map <c-s> set hidden!
map x $$f
map X !$f
map o &${OPENER:-xdg-open} "$f"
map O $${OPENER:-xdg-open} "$f"
map A :rename; cmd-end
map c push A<c-u>
map I :rename; cmd-home
map i :rename
map a :rename; cmd-right
map V push :!nvim<space>

source "~/.config/lf/shortcutrc"
