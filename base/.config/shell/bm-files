# These files automatically update when edited/saved in vim:

# keys	filename				description
bf	${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-files	# This file, a list of bookmarked files
bd	${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs		# A list of bookmarked directories similar to this file

# These do not update automatically, but on the next new instance of a program:

cfv	${XDG_CONFIG_HOME:-$HOME/.config}/nvim/init.lua		# neovim entrypoint
cfk	${XDG_CONFIG_HOME:-$HOME/.config}/nvim/lua/config/keymaps.lua	# neovim keymaps
cfo	${XDG_CONFIG_HOME:-$HOME/.config}/nvim/lua/config/options.lua	# neovim options
cfz	$ZDOTDIR/.zshrc						# zsh config
cfp10k	${XDG_CONFIG_HOME:-$HOME/.config}/zsh/.p10k.zsh		# powerlevel10k prompt
cfa	${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliasrc		# shell aliases
cfp	${XDG_CONFIG_HOME:-$HOME/.config}/shell/profile		# login profile
cfl	${XDG_CONFIG_HOME:-$HOME/.config}/lf/lfrc		# lf file manager config
cft	$HOME/.tmux.conf					# tmux config
cfg	${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config	# ghostty terminal config
cfh	${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf	# hyprland config
cfhp	${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprpaper.conf	# hyprpaper wallpaper config
cfaero	${XDG_CONFIG_HOME:-$HOME/.config}/aerospace/aerospace.toml	# aerospace mac window manager
